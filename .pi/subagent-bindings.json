{
	"default": {
		"maxDenies": 0,
		"maxWriteDenies": 2,
		"bash": {
			"deny": [
				"git stash",
				"git restore",
				"git checkout",
				"git switch",
				"git reset",
				"git clean",
				"git push",
				"git merge",
				"git rebase",
				"rm -rf"
			]
		}
	},
	"coder": {
		"bash": {
			"read": [
				"git status",
				"git diff",
				"git log",
				"git show",
				"git rev-parse",
				"git branch",
				"git worktree list",
				"cat",
				"ls",
				"rg",
				"find",
				"grep",
				"sed",
				"head",
				"tail",
				"wc",
				"echo",
				"node",
				"python3",
				"sh",
				"mise run typecheck",
				"mise run privacy"
			],
			"write": [
				"re: ^mise run (check|test|web|proto)(:[A-Za-z0-9:_-]+)?( .*)?$",
				"re: ^cd web && pnpm exec vitest run [\\w./-]+$",
				"git add",
				"git commit",
				"mkdir",
				"cp",
				"mv",
				"rm",
				"touch"
			],
			"env": {
				"pnpm_config_verify_deps_before_run": "false"
			},
			"writable": true,
			"writablePaths": ["~/.pi/worktrees"]
		}
	},
	"review": {
		"scope": ["."],
		"writeScope": ["web/.gen"],
		"maxDenies": 12,
		"bash": {
			"read": [
				"git status",
				"git diff",
				"git log",
				"git show",
				"git rev-parse",
				"git branch",
				"rg",
				"ls",
				"find",
				"grep",
				"sed",
				"head",
				"tail",
				"wc",
				"cat",
				"node",
				"sh",
				"test"
			],
			"write": [
				"re: ^mise run test(:[A-Za-z0-9:_-]+)?( .*)?$",
				"re: ^cd web && pnpm exec vitest run [\\w./-]+$"
			],
			"writable": true,
			"writablePaths": ["~/.pi/worktrees"]
		}
	}
}
