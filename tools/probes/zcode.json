{
  "platform": "zcode",
  "headers": "zcodePlatformHeaders",
  "base": "ZCODE_BASE",
  "requests": [
    {
      "name": "balance",
      "method": "GET",
      "path": "/api/v1/zcode-plan/billing/balance",
      "query": { "app_version": "3.16.3" },
      "write": false,
      "notes": "额度与计划（plans[] 里是领到的计划，balances[] 是桶）"
    },
    {
      "name": "preview",
      "method": "GET",
      "path": "/api/v1/zcode-plan/billing/preview",
      "query": { "app_version": "3.18.2", "platform": "win32-x64" },
      "write": false,
      "notes": "有没有可领的；200 + code 0 + 没有 data = 此刻没有"
    },
    {
      "name": "claim",
      "method": "POST",
      "path": "/api/v1/zcode-plan/billing/claim",
      "body": { "plan_id": "$arg.planId" },
      "write": true,
      "notes": "写操作：会真的领。必须带 --yes-write"
    }
  ]
}
