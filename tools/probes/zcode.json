{
  "platform": "zcode",
  "headers": "zcodePlatformHeaders",
  "base": "ZCODE_BASE",
  "requests": [
    {
      "name": "balance",
      "method": "GET",
      "path": "/api/v1/zcode-plan/billing/balance",
      "query": { "app_version": "$const.ZCODE_VERSION" },
      "write": false,
      "notes": "额度与计划（plans[] 里是领到的计划，balances[] 是桶）"
    },
    {
      "name": "touch",
      "method": "GET",
      "path": "/api/v1/marketing/touch",
      "headers": "zcodeMarketingHeaders",
      "query": { "seq": "0" },
      "write": false,
      "notes": "投放接口：**有没有可领**由这一条决定（banner 上带 claim_zcode_plan 按钮的投放才算）。billing/preview 不参与判据"
    },
    {
      "name": "claim",
      "method": "POST",
      "path": "/api/v1/zcode-plan/billing/claim",
      "body": { "plan_id": "$arg.planId" },
      "write": true,
      "notes": "写操作：会真的领。必须带 --yes-write"
    }
  ]
}
